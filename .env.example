# Copie ce fichier en `.env` et remplis les valeurs (le `.env` n'est jamais committé).
# Ce .env ne sert qu'aux OUTILS LOCAUX (ex: scripts/novita-watch.js). Les pods prod
# ne le lisent jamais : leurs env sont injectées au create par l'orchestrateur
# MassContent (cf README, section env vars). Pas de credentials AWS ici : l'upload
# S3 des pods passe par des URLs presignées PUT fournies par MassContent.

# RunPod — clé API (Settings > API Keys, rôle Read/Write)
RUNPOD_API_KEY=

# Novita — relevé périodique dispo/prix GPU (novita-watch.js)
NOVITA_API_KEY=
