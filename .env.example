# Copie ce fichier en `.env` et remplis les valeurs (le `.env` n'est jamais committé).

# RunPod — clé API (Settings > API Keys, rôle Read/Write)
RUNPOD_API_KEY=

# AWS S3 — sortie vidéo (réutilise le bucket MassContent, région eu-west-3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=eu-west-3
AWS_S3_BUCKET=
